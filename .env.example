# Copie a conexão PostgreSQL do Neon, incluindo sslmode=require.
DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require
# Escolha uma senha forte de no mínimo 12 caracteres. Nunca coloque no frontend.
APP_PASSWORD=
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Origem do app Android. Não é necessário liberar todos os sites.
APP_ALLOWED_ORIGIN=https://appassets.androidplatform.net
